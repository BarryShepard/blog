<!DOCTYPE html>
<html lang="ru">
  <!-- Powered by local files -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <meta name="description" content="{{ description or site.description }}" />
    <title>{% if title and title != site.displayName %}{{ title }} - {{ site.displayName }}{% else %}{{ site.displayName }}{% endif %}</title>
    <link rel="stylesheet" href="{{ base }}style.css" />
  </head>
  {% set isHome = page and page.url == "/" %}
  {% set isEntry = section %}
  {% set isTopPage = isHome or (page and page.fileSlug == "products") %}
  <body class="{% if isHome %}landing{% elif page and page.fileSlug %}page-{{ page.fileSlug }}{% endif %}">
    <header>
      {% if isTopPage %}
        <h1 class="site-title">{{ site.displayName }}</h1>
      {% else %}
        <h1 class="site-title"><a href="{{ base }}">{{ site.displayName }}</a></h1>
      {% endif %}
      {% if not isEntry %}
      <nav>
        <p>
          {% if isHome %}
            <span aria-current="page">Пишу</span>
          {% else %}
            <a href="{{ base }}">Пишу</a>
          {% endif %}
          {% if page and page.fileSlug == "products" %}
            <span aria-current="page">Делаю</span>
          {% else %}
            <a href="{{ base }}products/">Делаю</a>
          {% endif %}
        </p>
      </nav>
      {% endif %}
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <p>Делай то, что нравится</p>
    </footer>
  </body>
</html>
